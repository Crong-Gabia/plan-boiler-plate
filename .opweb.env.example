# Example proxy config for scripts/opweb.sh
# Copy to: .opweb.env  (repo-local) OR ~/.config/opencode/opweb.env

# Proxy settings (optional)
# HTTP_PROXY=http://proxy.company.local:8080
# HTTPS_PROXY=http://proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1

# opencode web defaults (optional)
OPWEB_PORT=4096
OPWEB_HOSTNAME=127.0.0.1
